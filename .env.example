# Public base URL used for canonical links, sitemap and social metadata
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin area (HTTP Basic Auth). If unset, /admin is disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional form delivery. If unset, the forms explain that delivery is not yet connected.
# Each receives a JSON POST: { type, data, submittedAt }
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
LISTINGS_WEBHOOK_URL=

# Future: managed Postgres + auth (see supabase/schema.sql and docs/ARCHITECTURE.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Monetization (Stripe). See docs/MONETIZATION.md. Leave blank to show "Coming soon" + waitlist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_LISTING_FEATURED=
# Optional free trial in days (1–90)
PREMIUM_TRIAL_DAYS=
# 32+ random characters; signs the Premium cookie and featured-listing payment links
ENTITLEMENT_SECRET=
# Optional: receives a summary of each verified Stripe event (e.g. a Slack or Zapier webhook)
BILLING_EVENTS_WEBHOOK_URL=
# Optional: set to "true" after enabling Stripe Tax
STRIPE_AUTOMATIC_TAX=

# ---- Marketing analytics (consent-gated; loaded only after the visitor allows analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
